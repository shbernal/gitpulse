{
  "name": "@shbernal/gitpulse",
  "version": "0.1.3",
  "description": "CLI to take the pulse of development projects.",
  "keywords": [
    "cli",
    "developer-tools",
    "github",
    "project-health",
    "repository-analysis",
    "terminal"
  ],
  "license": "MIT",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/gitpulse"
  },
  "bin": {
    "gitpulse": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run src/bin.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "format": "oxfmt",
    "visuals": "bun run scripts/render-visuals.ts",
    "build": "bun build src/bin.ts --target node --outfile dist/cli.js && chmod +x dist/cli.js",
    "build:bin": "bun build src/bin.ts --compile --outfile dist/gitpulse",
    "prepack": "bun run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "octokit": "^5.0.5",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.15",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
